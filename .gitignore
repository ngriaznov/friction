/target
**/*.rs.bk

# `wasm-pack build crates/friction-wasm --target web --out-dir web/pkg`'s
# generated output (the compiled `.wasm`, its JS glue, and `.d.ts`
# bindings) — CI rebuilds it from `crates/friction-wasm`'s source; only
# that source is committed.
/web/pkg

# OS noise
.DS_Store
Thumbs.db
/corpus-staging
/corpus/incoming/

# IDE
/.idea/

# One-time offline drafting environment for the dependency gold file
# (crates/friction-nlp/weights/NOTICE.md) — not a build or runtime
# dependency, reproducible from a `pip install spacy && python -m spacy
# download en_core_web_sm` in a fresh venv at that path.
tools/gold_dep/venv/
tools/gold_dep/__pycache__/

# Gold training data for the tagger and dependency parser.
#
# Derived, not source: regenerated from `corpus/` by `tools/gold_pos` and
# `tools/gold_dep` (see `tools/requirements.txt` for the pinned environment
# that makes it byte-reproducible). No build reads it — only the
# `train-tooling` examples do — so committing it would add several megabytes
# to history on every retrain for data that can be rebuilt on demand. The
# trained artifacts it produces ARE committed, because they are compiled into
# the binary.
crates/friction-nlp/weights/gold_pos_en.tsv
crates/friction-nlp/weights/gold_dep_en.conllu

# Python bytecode caches
__pycache__/
*.pyc

# Generated npm platform packages (built in CI by npm/build.mjs)
npm-dist/
npm/**/*.tgz

# Local research staging (external repos, corpora experiments) - never tracked
/.research/

# Playground packs staged locally by scripts/stage-local-packs.sh (copied
# from crates/*/weights|packs — never a source of truth, and multi-MB).
/web/packs/

# Session-local Claude Code project config (dev-server launch entries).
/.claude/

# general-evidence-v1's derived .bin: large (~25-45MB), optional runtime
# artifact `corpus-tool general-evidence pack` writes, never embedded and
# never committed (see friction_packs::general_evidence's own module
# docs) — only its small `.meta.toml` sidecar is tracked.
crates/friction-packs/packs/general-evidence-*.bin
